    SELECT
        e.Id,
        e.EmployeeCode,
        e.Name,
        d.Name AS Department,
        et.Name AS EmploymentType,
        l.Name AS Location,
        e.Attendance,
        e.Performance,
        e.ActiveProjects,
        e.ExperienceYears,
        e.Salary,
        e.JoiningYear,
        e.IsActive,
        e.DepartmentId,
        e.EmploymentTypeId,
        e.LocationId,
        COUNT(*) OVER() AS TotalCount
    FROM Employees e
    INNER JOIN Departments d
        ON e.DepartmentId = d.Id
    INNER JOIN Locations l
        ON e.LocationId = l.Id
    INNER JOIN EmploymentTypes et
        ON e.EmploymentTypeId = et.Id
    WHERE (@DepartmentId IS NULL OR e.DepartmentId = @DepartmentId)
      AND (@EmploymentTypeId IS NULL OR e.EmploymentTypeId = @EmploymentTypeId)
      AND (@LocationId IS NULL OR e.LocationId = @LocationId)
        order by e.Id
        OFFSET @offset rows
        FETCH NEXT  @size rows only
        
